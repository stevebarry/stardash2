# {{ ansible_managed }}
# Shared server block for all applications on this NGINX instance.
# Each application adds its own locations in {{ bi_nginx_locations_dir }}/<app>.conf.
# Created by whichever application is deployed first and not overwritten afterwards.
server {
    listen {{ bi_http_port }};
    server_name {{ bi_server_name }};

    include {{ bi_nginx_locations_dir }}/*.conf;
}
