[Unit]
Description=BI Dashboard stardash (gunicorn, /stardash)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/stardash
Environment="PATH=/opt/stardash/venv/bin"
# /run/stardash/ holds the gunicorn socket that NGINX connects to.
# --bind overrides the TCP address in gunicorn.conf.py.
RuntimeDirectory=stardash
RuntimeDirectoryMode=0755
ExecStart=/opt/stardash/venv/bin/gunicorn -c gunicorn.conf.py --bind unix:/run/stardash/gunicorn.sock wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
